---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPostBySlug } from '../../lib/posts';
import { marked } from 'marked';

const slug = Astro.params.slug;

if (!slug) {
	return new Response('Slug не найден', { status: 400 });
}

const post = await getPostBySlug(slug);

if (!post) {
	return new Response('Пост не найден', { status: 404 });
}

const pubDate = new Date(post.pub_date ?? post.date_created);
const bodyHtml = await marked.parse(post.body ?? '');
---

<BlogPost
	title={post.title}
	description={post.description}
	pubDate={pubDate}
	heroImageId={post.hero_image}
>
	<div set:html={bodyHtml} />
</BlogPost>
