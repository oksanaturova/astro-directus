---
import DirectusImage from '../../components/DirectusImage.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, IMAGE_SIZES } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';
import type { $brand } from 'astro:schema';
import { Image } from 'astro:assets';

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child :global(img) {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li :global(img) {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover :global(img) {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post, index) => (
							<li>
								{ <a href={`/blog/${post.slug}/`}>
									{post.hero_image && (
										<DirectusImage
											id={post.hero_image}
											alt={post.title}
											{...(index === 0
												? IMAGE_SIZES.postListFeatured
												: IMAGE_SIZES.postListCard
											)}
											eager
										/>
									)} 
									<h4 class="title">{post.title}</h4>
									<p class="date">
										<FormattedDate date={new Date(post.pub_date ?? post.date_created)} />
									</p>
									<p>
										{post.description}
									</p>
								</a> }
								
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
